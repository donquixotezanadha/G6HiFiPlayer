<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipToOutline="true"
    android:background="@drawable/widget_card_dark">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="10dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_art_circle"
        android:clipToOutline="true"
        android:contentDescription="Album artwork"
        android:src="@drawable/widget_empty_art" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="NO MUSIC PLAYING"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="10sp"
            android:textColor="#FFAAAAAA" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF6662C6"
            android:progressBackgroundTint="#556662C6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="3">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:padding="5dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_previous_24"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:padding="5dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_play_24"
                android:contentDescription="Play or pause" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:padding="5dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_next_24"
                android:contentDescription="Next" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_elapsed"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="0:00" />

        <TextView
            android:id="@+id/widget_duration"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="0:00" />
    </LinearLayout>
</LinearLayout>