<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_card_accent">
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="Album artwork" android:background="@drawable/widget_card_accent" android:src="@drawable/widget_empty_art"/>
    <FrameLayout android:id="@+id/widget_play_circle" android:layout_width="72dp" android:layout_height="72dp"
        android:layout_gravity="center_vertical|start" android:layout_marginStart="8dp" android:background="@drawable/widget_play_circle">
        <ImageButton android:id="@+id/widget_play" android:layout_width="match_parent" android:layout_height="match_parent"
            android:padding="10dp" android:background="@android:color/transparent" android:src="@drawable/ic_play_24"
            android:tint="#FFFFFF" android:contentDescription="Play or pause"/>
    </FrameLayout>
</FrameLayout>