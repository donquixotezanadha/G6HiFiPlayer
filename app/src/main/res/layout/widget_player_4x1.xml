<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipToOutline="true"
    android:background="@drawable/widget_card_dark">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="4dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_art_rounded"
        android:clipToOutline="true"
        android:contentDescription="Album artwork"
        android:src="@drawable/widget_empty_art" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="NO MUSIC PLAYING"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="#FFAAAAAA" />

        <TextView
            android:id="@+id/widget_elapsed"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="0:00" />

        <TextView
            android:id="@+id/widget_duration"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="0:00" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="46dp"
        android:layout_height="match_parent"
        android:layout_marginStart="1dp"
        android:padding="7dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_play_24"
        android:scaleType="fitCenter"
        android:contentDescription="Play or pause" />

</LinearLayout>