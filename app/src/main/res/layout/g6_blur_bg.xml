<?xml version="1.0" encoding="utf-8"?>
<!-- Hifi 1.82: rounded blur card background in 9 pieces. The four corners are fixed 16dp squares (true circles, the same 16dp as the
     4x1 card, the mini player and the windows), the edges and the centre stretch. One bitmap stretched over the whole card gave
     distorted corners when the launcher's real size differed from the size it reported. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="16dp" android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_bg_tl"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/w_bg_t"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_weight="1"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/w_bg_tr"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitXY" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_bg_l"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/w_bg_c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/w_bg_r"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="16dp" android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_bg_bl"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/w_bg_b"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_weight="1"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/w_bg_br"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="fitXY" />
    </LinearLayout>
</LinearLayout>
