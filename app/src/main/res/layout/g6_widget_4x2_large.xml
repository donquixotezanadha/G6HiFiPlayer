<?xml version="1.0" encoding="utf-8"?>
<!-- Build 2.18: no album art in the widget (2.19 brings the big art back); title, singer, album, thin progress bar and previous / play / next on the right. Background 80% black. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/g6_widget_bg_4x2">


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="NO MUSIC PLAYING"
            android:textSize="20sp"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="#FFE0E0E6" />

        <TextView
            android:id="@+id/w_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="#FFB3B3BB" />

        <ProgressBar
            android:id="@+id/w_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/g6_widget_progress" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:background="@drawable/g6_widget_btn"
                android:src="@drawable/g6_w_ic_prev"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/w_play"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@drawable/g6_widget_btn"
                android:src="@drawable/g6_w_ic_play"
                android:contentDescription="Play or pause" />

            <ImageButton
                android:id="@+id/w_next"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:background="@drawable/g6_widget_btn"
                android:src="@drawable/g6_w_ic_next"
                android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
