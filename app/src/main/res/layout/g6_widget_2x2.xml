<?xml version="1.0" encoding="utf-8"?>
<!-- Build 2.51: Build 2.48 artwork preserved; enlarge only the compact play/pause control. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="14dp"
        android:scaleType="fitCenter"
        android:contentDescription="Album artwork" />

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="8dp"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:background="@drawable/g6_widget_btn_square"
        android:src="@drawable/g6_w_ic_play"
        android:contentDescription="Play or pause" />
</FrameLayout>
