<?xml version="1.0" encoding="utf-8"?>
<!-- Hifi 1.60: the card fills the area the launcher gives (vertical edge gap, text sizes and these values come from the Setting window);
     the cover and the button row grow with the card height.
     Build 2.66: restore the tested compact Build 2.58 values for the dedicated 4x1 provider.
     Build 3.18: the card has a fixed 70dp height and is centred in whatever area the launcher gives, so LG and Nova look the same.
     Balanced padding: cover to left edge, cover to top/bottom edge and text column to right edge are all 8dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/w_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/g6_widget_bg_4x1">

        <ImageView
            android:id="@+id/w_art"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="Album artwork" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="NO MUSIC PLAYING"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="#FFE0E0E6" />

            <ImageView
                android:id="@+id/w_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="3dp"
                android:scaleType="fitXY"
                android:contentDescription="Track progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="1dp"
                android:orientation="horizontal"
                android:gravity="start|bottom">

                <ImageButton
                    android:id="@+id/w_prev"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="0dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/g6_widget_btn"
                    android:src="@drawable/ic_previous_s"
                    android:contentDescription="Previous" />

                <ImageButton
                    android:id="@+id/w_play"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="0dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/g6_widget_btn"
                    android:src="@drawable/ic_play_s"
                    android:contentDescription="Play or pause" />

                <ImageButton
                    android:id="@+id/w_next"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="0dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/g6_widget_btn"
                    android:src="@drawable/ic_next_s"
                    android:contentDescription="Next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
