<?xml version="1.0" encoding="utf-8"?>
<!-- Build 2.58: compact one-row 4x1 layout; keep widget controls and artwork within 70dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/w_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="@drawable/g6_widget_bg_4x2">

        <ImageView
            android:id="@+id/w_art"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="1dp"
            android:scaleType="fitCenter"
            android:contentDescription="Album artwork" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="NO MUSIC PLAYING"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="#FFE0E0E6" />

            <ImageView
                android:id="@+id/w_progress"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="2dp"
                android:scaleType="fitXY"
                android:contentDescription="Track progress" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginTop="1dp"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <ImageButton
                    android:id="@+id/w_prev"
                    android:layout_width="36dp"
                    android:layout_height="26dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/g6_widget_btn"
                    android:src="@drawable/ic_previous_24"
                    android:contentDescription="Previous" />

                <ImageButton
                    android:id="@+id/w_play"
                    android:layout_width="36dp"
                    android:layout_height="26dp"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/g6_widget_btn"
                    android:src="@drawable/ic_play_24"
                    android:contentDescription="Play or pause" />

                <ImageButton
                    android:id="@+id/w_next"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/g6_widget_btn"
                    android:src="@drawable/ic_next_24"
                    android:contentDescription="Next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
