<?xml version="1.0" encoding="utf-8"?>
<!-- Build 2.41: compact 4x1 music widget with a rounded card and rounded album artwork. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="@drawable/g6_widget_bg_4x2">

    <ImageView
        android:id="@+id/w_art"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="fitCenter"
        android:contentDescription="Album artwork" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="NO MUSIC PLAYING"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="10sp"
            android:textColor="#FFE0E0E6" />

        <ProgressBar
            android:id="@+id/w_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/g6_widget_progress" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_prev"
        android:layout_width="28dp"
        android:layout_height="34dp"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:background="@drawable/g6_widget_btn"
        android:src="@drawable/g6_w_ic_prev"
        android:contentDescription="Previous" />

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="32dp"
        android:layout_height="38dp"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:background="@drawable/g6_widget_btn"
        android:src="@drawable/g6_w_ic_play"
        android:contentDescription="Play or pause" />

    <ImageButton
        android:id="@+id/w_next"
        android:layout_width="28dp"
        android:layout_height="34dp"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:background="@drawable/g6_widget_btn"
        android:src="@drawable/g6_w_ic_next"
        android:contentDescription="Next" />
</LinearLayout>
