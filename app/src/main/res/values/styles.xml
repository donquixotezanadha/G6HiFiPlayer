<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep Android's starting window as a plain theme-matched surface.
         The app's existing in-app startup splash is the only splash logo. -->
    <style name="Theme.G6HiFiPlayer" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#7C4DFF</item>
    </style>

    <!-- Android 9 Activity window for users whose saved in-app theme is Dark. -->
    <style name="Theme.G6HiFiPlayer.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF101014</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#7C4DFF</item>
    </style>
</resources>
