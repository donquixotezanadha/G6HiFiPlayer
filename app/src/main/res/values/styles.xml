<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Build 3.16: one visible splash. Android 9 launch window itself carries the foreground logo. -->
    <style name="Theme.G6HiFiPlayer" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_splash_light</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#7C4DFF</item>
    </style>

    <style name="Theme.G6HiFiPlayer.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_splash_dark</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#7C4DFF</item>
    </style>
</resources>
