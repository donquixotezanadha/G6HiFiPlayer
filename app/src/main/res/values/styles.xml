<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Android 9 starting window already looks like the in-app splash, avoiding a blank frame before it. -->
    <style name="Theme.G6HiFiPlayer" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/window_splash_light</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#7C4DFF</item>
    </style>

    <style name="Theme.G6HiFiPlayer.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/window_splash_dark</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#7C4DFF</item>
    </style>
</resources>
